{
  "info": {
    "name": "Tourism AI Service — Local API Tests",
    "description": "Import into Postman to test the AI microservice only (not the separate backend/frontend). Set baseUrl to the address of python Service/main.py (default http://localhost:8000). apiPrefix is /algorithm/api in Service/config.json. Audio/image requests require local files and the configured models. This collection lists active registered routes; commented-out video endpoint is intentionally excluded.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "apiPrefix",
      "value": "/algorithm/api",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Login — travel planning",
      "item": [
        {
          "name": "Travel — 3 routes",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/login/travel",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "{{apiPrefix}}",
                "login",
                "travel"
              ]
            },
            "description": "Expected answer: array of 4 strings (introduction + 3 routes).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"arrival_datetime\": \"2026-12-01\",\n  \"departure_datetime\": \"2026-12-05\",\n  \"traveler_ages\": [\n    25,\n    30\n  ],\n  \"historical_culture_interests\": [\n    \"晋祠\"\n  ],\n  \"folk_culture_interests\": [\n    \"平遥古城\"\n  ],\n  \"famous_humanistic_interests\": [],\n  \"red_culture_interests\": [],\n  \"food_interests\": [\n    \"山西面食\"\n  ],\n  \"celebrity_culture_interests\": [],\n  \"interest_priority_order\": [\n    \"historical_culture\",\n    \"food\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is valid JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Travel returns intro + 3 routes\", function () { const b=pm.response.json(); pm.expect(b.success).to.eql(true); pm.expect(b.answer).to.be.an(\"array\").with.lengthOf(4); b.answer.forEach(x=>pm.expect(x).to.be.a(\"string\")); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Food — lunch & dinner (6 restaurants)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}{{apiPrefix}}/login/food",
              "host": [
