                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP status is 200\", function () { pm.response.to.have.status(200); });",
                  "pm.test(\"Response is valid JSON\", function () { pm.response.to.be.json; });",
                  "pm.test(\"Food returns intro + 3 per requested meal\", function () { const b=pm.response.json(); pm.expect(b.success).to.eql(true); pm.expect(b.answer).to.be.an(\"array\").with.lengthOf(7); pm.expect(b.answer[1]).to.include(\"【午餐】\"); pm.expect(b.answer[4]).to.include(\"【晚餐】\"); });"
                ]
              }
            }
